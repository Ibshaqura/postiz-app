# syntax=docker/dockerfile:1.7
#
# Same image as Dockerfile.dev (upstream), but with build caches so that a
# small code change does not redo everything:
#   - the pnpm store lives in a BuildKit cache → packages are downloaded once
#     and only re-linked on later builds;
#   - Next.js keeps its build cache (.next/cache) between builds → only the
#     changed pages/modules are recompiled.
# The caches stay on the build machine, they are not part of the image.
#
# Build:  DOCKER_BUILDKIT=1 docker build -f Dockerfile.wasalaa -t postiz-wasalaa .

FROM node:22.23.4-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN --mount=type=cache,id=postiz-pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile --store-dir /pnpm-store

RUN --mount=type=cache,id=postiz-next-cache,target=/app/apps/frontend/.next/cache \
    NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
