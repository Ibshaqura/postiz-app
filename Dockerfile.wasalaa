# syntax=docker/dockerfile:1.7
#
# App image for the wasalaa server. Same result as Dockerfile.dev (upstream),
# but fast to rebuild after small code changes:
#   - node_modules come from the deps image (Dockerfile.wasalaa-deps), which
#     is only rebuilt when dependencies change — so the ~6 GB of packages is
#     not re-installed or re-packed on every build;
#   - Next.js keeps its build cache between builds (BuildKit cache mount),
#     so only changed pages/modules are recompiled.
#
# Use scripts/wasalaa-deploy.sh rather than building this by hand.

ARG DEPS_IMAGE=postiz-wasalaa-deps:latest
FROM ${DEPS_IMAGE}
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

WORKDIR /app
COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# dependencies are already there: this only re-links workspace packages and
# re-runs postinstall (prisma generate) against the new source
RUN --mount=type=cache,id=postiz-pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile --offline --store-dir /pnpm-store

RUN --mount=type=cache,id=postiz-next-cache,target=/app/apps/frontend/.next/cache \
    NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
